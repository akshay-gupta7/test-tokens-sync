      "$value": "{scale.rem.8xl}"
    },
    "text-9xl": {
      "$type": "fontSizes",
      "$value": "{scale.rem.9xl}"
    }
  },
  "letter-spacing": {
    "sm": {
      "$type": "letterSpacing",
      "$value": "-0.2"
    },
    "md": {
      "$type": "letterSpacing",
      "$value": "-0.75"
    },
    "lg": {
      "$type": "letterSpacing",
      "$value": "-2.5"
    }
  },
  "line-height": {
    "100": {
      "$extensions": {
        "com.figma.scopes": [
          "LINE_HEIGHT"
        ],
        "com.figma.codeSyntax": {
          "Web": "",
          "Android": "",
          "iOS": ""
        }
      },
      "$type": "lineHeights",
      "$value": "100%",
      "$description": "Reduces line-height to be same as font size"
    },
    "120": {
      "$extensions": {
        "com.figma.scopes": [
          "LINE_HEIGHT"
        ],
        "com.figma.codeSyntax": {
          "Web": "",
          "Android": "",
          "iOS": ""
        }
      },
      "$type": "lineHeights",
      "$value": "120%",
      "$description": "Used for Typography where the line height needs to be less than default. Titles of product cards for instance."
    },
    "150": {
      "$extensions": {
        "com.figma.scopes": [
          "LINE_HEIGHT"
        ],
        "com.figma.codeSyntax": {
          "Web": "",
          "Android": "",
          "iOS": ""
        }
      },
      "$type": "lineHeights",
      "$value": "150%"
    },
