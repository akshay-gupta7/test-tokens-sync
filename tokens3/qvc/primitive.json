  "font-family": {
    "ttNormsPro": {
      "$type": "fontFamilies",
      "$value": "TT Norms Pro"
    }
  },
  "font-weight": {
    "Bold": {
      "$type": "fontWeights",
      "$value": "Bold"
    },
    "Medium": {
      "$type": "fontWeights",
      "$value": "Medium"
    },
    "Normal": {
      "$type": "fontWeights",
      "$value": "Normal"
    },
    "DemiBold": {
      "$type": "fontWeights",
      "$value": "DemiBold"
    }
  },
  "font-size": {
    "text-xs": {
      "$type": "fontSizes",
      "$value": "{scale.rem.sm}"
    },
    "text-sm": {
      "$type": "fontSizes",
      "$value": "0.875rem",
      "$description": "Not divisbile by 4 but needed for our system."
    },
    "text-base": {
      "$type": "fontSizes",
      "$value": "{scale.rem.md}",
      "$description": "16px = 1rem"
    },
    "text-lg": {
      "$type": "fontSizes",
      "$value": "{scale.rem.lg}"
    },
    "text-xl": {
      "$type": "fontSizes",
