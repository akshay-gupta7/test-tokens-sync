{
  "border-width": {
    "0": {
      "$type": "borderWidth",
      "$value": "0"
    },
    "1": {
      "$type": "borderWidth",
      "$value": "0.0625rem"
    },
    "2": {
      "$type": "borderWidth",
      "$value": "0.125rem"
    },
    "4": {
      "$type": "borderWidth",
      "$value": "0.25rem"
    },
    "8": {
      "$type": "borderWidth",
      "$value": "0.5rem"
    }
  },
  "border-radius": {
    "0": {
      "$type": "borderRadius",
      "$value": "0"
    },
    "xs": {
      "$type": "borderRadius",
      "$value": "{sizing.4}"
    },
    "sm": {
      "$type": "borderRadius",
      "$value": "{sizing.8}"
    },
    "md": {
      "$type": "borderRadius",
      "$value": "{sizing.12}"
    },
    "lg": {
      "$type": "borderRadius",
      "$value": "{sizing.16}"
    },
    "xl": {
      "$type": "borderRadius",
      "$value": "{sizing.20}"
    },
    "round": {
      "$type": "borderRadius",
      "$value": "999.9rem"
    }
  },
  "focus": {
    "$type": "border",
    "$value": {
      "color": "{color.border.focus}",
      "width": "{border-width.2}",
      "style": "solid"
    }
  },
  "divider": {
    "sm": {
      "$type": "border",
      "$value": {
        "color": "{color.divider.sm}",
        "width": "{border-width.1}",
        "style": "solid"
      }
    },
    "md": {
      "$type": "border",
      "$value": {
        "color": "{color.divider.md}",
        "width": "{border-width.4}",
        "style": "solid"
      }
    }
  }
}